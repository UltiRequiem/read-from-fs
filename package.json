{
  "name": "read-from-fs",
  "version": "0.1.0",
  "author": "Eliaz Bobadilla <eliaz.bobadilladev@gmail.com>",
  "license": "MIT",
  "description": "Utilities to read files from the file system",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "build:docs": "typedoc --out docs src",
    "dev:docs": "typedoc --watch --out docs src",
    "fmt": "prettier --write 'src/**/*.ts'",
    "lint": "eslint 'src/**/*.ts' && prettier --check 'src/**/*.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-tsdoc": "^0.5.4",
    "prettier": "^3.9.10",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "files"
  ],
  "packageManager": "pnpm@12.6.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UltiRequiem/read-from-fs.git"
  }
}
